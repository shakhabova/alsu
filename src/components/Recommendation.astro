---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="section recommendation" id="recommendation">
  <div class="container recommendation-grid">
    <div class="recommendation-text reveal">
      <span class="eyebrow">{t("recommendation.eyebrow")}</span>
      <h2 class="section-title">{t("recommendation.title")}</h2>

      <p class="lead recommendation-intro">
        {t("recommendation.intro")}
      </p>

      <div class="doctor-card">
        <div class="doctor-card-header">
          <h3 class="doctor-name">{t("recommendation.doctorName")}</h3>
          <span class="doctor-badge">{t("recommendation.doctorTitle")}</span>
        </div>
        <p class="doctor-info">
          {t("recommendation.doctorInfo")}
        </p>
      </div>

      <div class="referral-block">
        <p class="referral-note">{t("recommendation.referralNote")}</p>
        <a class="referral-link" href="#contact">{t("recommendation.referralAction")}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .recommendation {
    background: var(--cream-soft);
    position: relative;
    overflow: hidden;
  }

  .recommendation-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .recommendation-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .recommendation-intro {
    margin-top: 1.2rem;
    margin-bottom: 1.8rem;
    font-size: clamp(1.05rem, 1.3vw, 1.2rem);
    line-height: 1.6;
    color: var(--brown-soft);
  }

  .doctor-card {
    background: var(--white);
    border: 1px solid var(--taupe);
    border-radius: 20px;
    padding: 2rem;
    width: 100%;
    margin-bottom: 2rem;
    box-shadow: 0 10px 30px -15px rgba(58, 42, 30, 0.08);
  }

  .doctor-card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--taupe) 40%, transparent);
    padding-bottom: 0.8rem;
  }

  .doctor-name {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    color: var(--brown);
    font-weight: 500;
    margin: 0;
  }

  .doctor-badge {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--clay);
  }

  .doctor-info {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--brown-soft);
    margin: 0;
  }

  .referral-note {
    margin: 0 0 1.2rem;
    color: var(--brown-soft);
    line-height: 1.65;
  }
  .referral-link {
    color: var(--brown);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-color: var(--taupe);
    transition: text-decoration-color 0.2s ease;
  }
  .referral-link:hover {
    text-decoration-color: currentColor;
  }
  .referral-link:focus-visible {
    outline: 2px solid var(--clay);
    outline-offset: 5px;
  }
</style>
