---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const certificates = [
  {
    title: t("certs.cert11.title"),
    org: t("certs.cert11.org"),
    year: "2025",
    desc: t("certs.cert11.desc"),
    image: "/images/certificates/cert11.png",
  },
  {
    title: t("certs.cert9.title"),
    org: t("certs.cert9.org"),
    year: "2024",
    desc: t("certs.cert9.desc"),
    image: "/images/certificates/cert9.jpg",
  },
  {
    title: t("certs.cert7.title"),
    org: t("certs.cert7.org"),
    year: "2024",
    desc: t("certs.cert7.desc"),
    image: "/images/certificates/cert7.jpg",
  },
  {
    title: t("certs.cert1.title"),
    org: t("certs.cert1.org"),
    year: "2019",
    desc: t("certs.cert1.desc"),
    image: "/images/certificates/cert1.png",
  },
  {
    title: t("certs.cert2.title"),
    org: t("certs.cert2.org"),
    year: "2021",
    desc: t("certs.cert2.desc"),
    image: "/images/certificates/cert2.png",
  },
  {
    title: t("certs.cert3.title"),
    org: t("certs.cert3.org"),
    year: "2022",
    desc: t("certs.cert3.desc"),
    image: "/images/certificates/cert3.png",
  },
  {
    title: t("certs.cert4.title"),
    org: t("certs.cert4.org"),
    year: "2023",
    desc: t("certs.cert4.desc"),
    image: "/images/certificates/cert4.png",
  },
  {
    title: t("certs.cert5.title"),
    org: t("certs.cert5.org"),
    year: "2023",
    desc: t("certs.cert5.desc"),
    image: "/images/certificates/cert5.jpg",
  },
  {
    title: t("certs.cert6.title"),
    org: t("certs.cert6.org"),
    year: "2023",
    desc: t("certs.cert6.desc"),
    image: "/images/certificates/cert6.png",
  },
  {
    title: t("certs.cert8.title"),
    org: t("certs.cert8.org"),
    year: "2024",
    desc: t("certs.cert8.desc"),
    image: "/images/certificates/cert8.jpg",
  },
  {
    title: t("certs.cert10.title"),
    org: t("certs.cert10.org"),
    year: "2025",
    desc: t("certs.cert10.desc"),
    image: "/images/certificates/cert10.jpg",
  },
];
---

<section class="section certificates" id="certificates">
  <div class="container">
    <div class="certificates-head reveal">
      <span class="eyebrow">{t("certs.eyebrow")}</span>
      <h2 class="section-title">{t("certs.title")}</h2>
      <p class="lead">
        {t("certs.lead")}
      </p>
    </div>

    <div
      class="certificates-carousel-wrapper"
      aria-label={t("certs.carousel_label")}
    >
      <div class="certificates-track" id="certs-track">
        {
          certificates.map((c) => (
            <article class="cert-card reveal">
              <div
                class="cert-image-wrapper"
                data-src={c.image}
                data-title={c.title}
              >
                <img src={c.image} alt={c.title} loading="lazy" />
                <div class="cert-overlay">
                  <span class="cert-zoom-icon">
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <circle cx="11" cy="11" r="8" />
                      <line x1="21" y1="21" x2="16.65" y2="16.65" />
                      <line x1="11" y1="8" x2="11" y2="14" />
                      <line x1="8" y1="11" x2="14" y2="11" />
                    </svg>
                  </span>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Controls -->
      <button
        class="carousel-control prev"
        id="certs-prev"
        aria-label={t("certs.prev")}
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button
        class="carousel-control next"
        id="certs-next"
        aria-label={t("certs.next")}
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <!-- Dots Indicators -->
      <div
        class="carousel-dots"
        id="certs-dots"
        role="tablist"
        aria-label={t("certs.dots_nav")}
      >
        {
          certificates.map((_, i) => (
            <button
              class={`carousel-dot ${i === 0 ? "active" : ""}`}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
              aria-label={`Go to slide ${i + 1}`}
              data-index={i}
            />
          ))
        }
      </div>
    </div>

    <!-- Association Membership Banner -->
    <div class="association-card reveal">
      <div class="association-header">
        <div class="association-logo-wrapper">
          <img
            src="/images/certificates/logo_doula.jpg"
            alt="АПД"
            class="association-logo"
            loading="lazy"
          />
        </div>
        <h3 class="association-title">{t("certs.association.title")}</h3>
      </div>
      <div class="association-body">
        <p class="association-text">{t("certs.association.text")}</p>

        <!-- Key Highlights Row -->
        <div class="association-highlights">
          <div class="highlight-item">
            <span class="highlight-icon">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
            <span class="highlight-label"
              >{
                lang === "ru"
                  ? "Квалификация и этика"
                  : "Qualification & Ethics"
              }</span
            >
          </div>
          <div class="highlight-item">
            <span class="highlight-icon">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
            <span class="highlight-label"
              >{
                lang === "ru" ? "Постоянное обучение" : "Continuous Education"
              }</span
            >
          </div>
          <div class="highlight-item">
            <span class="highlight-icon">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
            <span class="highlight-label"
              >{lang === "ru" ? "Надежная опора" : "Reliable Ally"}</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Lightbox Modal -->
  <div class="lightbox" id="lightbox" aria-hidden="true" role="dialog">
    <button class="lightbox-close" aria-label={t("certs.modal_close")}>
      <svg
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <div class="lightbox-content">
      <img id="lightbox-img" src="" alt="" />
      <p id="lightbox-caption"></p>
    </div>
  </div>
</section>

<style>
  .certificates {
    background: color-mix(in srgb, var(--sand) 35%, var(--cream) 65%);
  }
  .certificates-head {
    max-width: 640px;
    margin-bottom: clamp(2.4rem, 5vw, 3.6rem);
  }
  .certificates-head .lead {
    margin-top: 1.2rem;
  }

  /* ---------- Carousel ---------- */
  .certificates-carousel-wrapper {
    position: relative;
    width: 100%;
  }

  .certificates-track {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    -webkit-overflow-scrolling: touch;
    padding: 1.5rem 0.5rem;
    margin: -1.5rem -0.5rem;
    /* Add gradient mask for premium faded edge effect */
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 2%,
      #000 98%,
      transparent
    );
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 2%,
      #000 98%,
      transparent
    );
  }

  .certificates-track::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .cert-card {
    flex: 0 0 calc(33.333% - 1.33rem); /* 3 cards on desktop */
    scroll-snap-align: start;
    background: var(--cream);
    border: 1px solid color-mix(in srgb, var(--taupe) 45%, transparent);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  @media (max-width: 992px) {
    .cert-card {
      flex: 0 0 calc(50% - 1rem); /* 2 cards on tablet */
    }
  }

  @media (max-width: 600px) {
    .cert-card {
      flex: 0 0 85%; /* 1 card (85% width) on mobile for previewing next slide */
    }
  }

  .cert-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 48px -28px rgba(58, 42, 30, 0.45);
    border-color: var(--clay);
  }

  .cert-image-wrapper {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    cursor: zoom-in;
    background: var(--taupe);
  }

  .cert-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cert-card:hover .cert-image-wrapper img {
    transform: scale(1.06);
  }

  .cert-overlay {
    position: absolute;
    inset: 0;
    background: rgba(58, 42, 30, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cert-image-wrapper:hover .cert-overlay {
    opacity: 1;
  }

  .cert-zoom-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--cream);
    color: var(--brown-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.2);
    transform: scale(0.9);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cert-image-wrapper:hover .cert-zoom-icon {
    transform: scale(1);
  }

  .cert-info {
    padding: 1.8rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .cert-org {
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--clay);
    margin-bottom: 0.6rem;
  }

  .cert-title {
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--brown);
    margin-bottom: 0.8rem;
  }

  .cert-desc {
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--brown-soft);
    font-weight: 300;
    margin: 0;
  }

  /* Lightbox Modal Styling */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(44, 32, 21, 0.92);
    backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    padding: var(--pad);
  }

  .lightbox.active {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-close {
    position: absolute;
    top: 2rem;
    right: 2rem;
    background: none;
    border: none;
    color: var(--cream);
    cursor: pointer;
    padding: 8px;
    transition:
      transform 0.3s ease,
      color 0.3s ease;
    z-index: 102;
  }

  .lightbox-close:hover {
    transform: scale(1.1);
    color: var(--sand);
  }

  .lightbox-content {
    max-width: 900px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: scale(0.95);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lightbox.active .lightbox-content {
    transform: scale(1);
  }

  .lightbox-content img {
    max-width: 100%;
    max-height: 75vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.5);
  }

  #lightbox-caption {
    margin-top: 1.4rem;
    color: var(--cream);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    text-align: center;
    letter-spacing: 0.02em;
  }

  /* Carousel Navigation Controls */
  .carousel-control {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--cream);
    border: 1px solid color-mix(in srgb, var(--taupe) 45%, transparent);
    color: var(--brown);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(58, 42, 30, 0.1);
    z-index: 10;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .carousel-control:hover:not(:disabled) {
    background: var(--brown-deep);
    color: var(--cream);
    border-color: var(--brown-deep);
    transform: translateY(-50%) scale(1.05);
    box-shadow: 0 8px 24px rgba(58, 42, 30, 0.2);
  }

  .carousel-control:active:not(:disabled) {
    transform: translateY(-50%) scale(0.95);
  }

  .carousel-control.prev {
    left: -24px;
  }

  .carousel-control.next {
    right: -24px;
  }

  .carousel-control:disabled {
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 1140px) {
    .carousel-control.prev {
      left: 10px;
    }
    .carousel-control.next {
      right: 10px;
    }
  }

  @media (max-width: 768px) {
    .carousel-control {
      display: none;
    }
  }

  /* Carousel Dots */
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: color-mix(in srgb, var(--taupe) 40%, transparent);
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .carousel-dot.active {
    width: 24px;
    border-radius: 4px;
    background: var(--clay);
  }

  .carousel-dot:hover:not(.active) {
    background: var(--brown-soft);
  }

  /* Association Membership Card Redesign */
  .association-card {
    display: flex;
    flex-direction: column;
    gap: 2.2rem;
    max-width: 960px;
    margin: 4.5rem auto 0;
    padding: 3.5rem clamp(1.8rem, 6vw, 4rem);
    background: linear-gradient(
      135deg,
      var(--cream) 0%,
      color-mix(in srgb, var(--sand) 12%, var(--cream) 88%) 100%
    );
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid color-mix(in srgb, var(--taupe) 45%, transparent);
    border-left: 6px solid var(--clay); /* Elegant editorial border accent */
    border-radius: 24px;
    box-shadow: 0 20px 48px -20px rgba(58, 42, 30, 0.1);
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.4s ease;
  }

  .association-card:hover {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--clay) 40%, transparent);
    border-left-color: var(--clay);
    box-shadow: 0 30px 60px -20px rgba(183, 159, 130, 0.22);
  }

  .association-header {
    display: flex;
    align-items: center;
    gap: 2.2rem;
  }

  .association-logo-wrapper {
    flex-shrink: 0;
    width: 170px;
    aspect-ratio: 1170 / 474;
    border-radius: 12px;
    overflow: hidden;
    background: #ffffff;
    padding: 0.6rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--taupe) 30%, transparent);
    box-shadow: 0 8px 24px -10px rgba(58, 42, 30, 0.15);
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .association-card:hover .association-logo-wrapper {
    transform: scale(1.04) translateY(-2px);
    box-shadow: 0 12px 28px -10px rgba(58, 42, 30, 0.22);
  }

  .association-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: transparent;
  }

  .association-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    line-height: 1.25;
    color: var(--brown-deep);
    margin: 0;
  }

  .association-body {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .association-text {
    font-size: clamp(0.96rem, 1.8vw, 1.06rem);
    line-height: 1.8;
    color: var(--brown-soft);
    font-weight: 300;
    margin: 0;
  }

  /* Highlights grid */
  .association-highlights {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    padding-top: 2rem;
    border-top: 1px dashed color-mix(in srgb, var(--taupe) 45%, transparent);
  }

  .highlight-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .highlight-icon {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--clay) 12%, var(--cream) 88%);
    color: var(--clay);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .highlight-label {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--brown);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  @media (max-width: 768px) {
    .association-card {
      margin-top: 3.5rem;
      padding: 2.5rem 1.8rem;
      gap: 1.8rem;
    }

    .association-header {
      flex-direction: column;
      text-align: center;
      gap: 1.2rem;
    }

    .association-logo-wrapper {
      width: 140px;
    }

    .association-text {
      text-align: center;
    }

    .association-highlights {
      justify-content: center;
      gap: 1.5rem;
      padding-top: 1.5rem;
    }
  }

  @media (max-width: 860px) {
    .cert-image-wrapper {
      aspect-ratio: 16 / 10;
    }
    .lightbox-close {
      top: 1rem;
      right: 1rem;
    }
  }
</style>

<script>
  (() => {
    // Lightbox Modal Logic
    const wrappers = document.querySelectorAll(".cert-image-wrapper");
    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById(
      "lightbox-img",
    ) as HTMLImageElement | null;
    const lightboxCaption = document.getElementById("lightbox-caption");
    const closeBtn = document.querySelector(".lightbox-close");

    if (!lightbox || !lightboxImg || !lightboxCaption || !closeBtn) return;

    const openLightbox = (src: string, title: string) => {
      lightboxImg.src = src;
      lightboxImg.alt = title;
      lightboxCaption.textContent = title;
      lightbox.classList.add("active");
      lightbox.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    const closeLightbox = () => {
      lightbox.classList.remove("active");
      lightbox.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      setTimeout(() => {
        lightboxImg.src = "";
        lightboxImg.alt = "";
        lightboxCaption.textContent = "";
      }, 400);
    };

    wrappers.forEach((wrapper) => {
      wrapper.addEventListener("click", () => {
        const src = wrapper.getAttribute("data-src");
        const title = wrapper.getAttribute("data-title");
        if (src && title) {
          openLightbox(src, title);
        }
      });
    });

    closeBtn.addEventListener("click", closeLightbox);

    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) {
        closeLightbox();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && lightbox.classList.contains("active")) {
        closeLightbox();
      }
    });

    // Carousel Logic
    const root = document.querySelector(".certificates-carousel-wrapper");
    const track = document.getElementById("certs-track");
    const prev = document.getElementById("certs-prev");
    const next = document.getElementById("certs-next");
    const dotsContainer = document.getElementById("certs-dots");

    if (!root || !track || !prev || !next || !dotsContainer) return;

    const slides = Array.from(
      track.querySelectorAll(".cert-card"),
    ) as HTMLElement[];
    const dots = Array.from(dotsContainer.querySelectorAll(".carousel-dot"));
    if (!slides.length) return;

    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    let current = 0;
    let landTimer = 0;

    const targetFor = (idx: number) => {
      const max = track.scrollWidth - track.clientWidth;
      return Math.max(
        0,
        Math.min(slides[idx].offsetLeft - track.offsetLeft, max),
      );
    };

    const goTo = (i: number) => {
      const idx = (i + slides.length) % slides.length;
      const target = targetFor(idx);
      current = idx;

      dots.forEach((d, k) => {
        if (k === idx) {
          d.classList.add("active");
          d.setAttribute("aria-selected", "true");
        } else {
          d.classList.remove("active");
          d.setAttribute("aria-selected", "false");
        }
      });

      if (reduce) {
        track.scrollTo({ left: target, behavior: "auto" });
        return;
      }

      // Disable snap during the move so mandatory snap can't fight the programmatic scroll
      track.style.scrollSnapType = "none";
      track.scrollTo({ left: target, behavior: "smooth" });
      clearTimeout(landTimer);
      landTimer = window.setTimeout(() => {
        track.scrollTo({ left: target, behavior: "auto" });
        track.style.scrollSnapType = "";
      }, 520);
    };

    // Reflect current slide in dots while user scrolls or swipes
    const sync = () => {
      const center = track.scrollLeft + track.clientWidth / 2;
      let best = 0,
        bestDist = Infinity;
      slides.forEach((s, i) => {
        const c = s.offsetLeft - track.offsetLeft + s.offsetWidth / 2;
        const d = Math.abs(c - center);
        if (d < bestDist) {
          bestDist = d;
          best = i;
        }
      });
      current = best;
      dots.forEach((d, i) => {
        if (i === best) {
          d.classList.add("active");
          d.setAttribute("aria-selected", "true");
        } else {
          d.classList.remove("active");
          d.setAttribute("aria-selected", "false");
        }
      });
    };

    let raf = 0;
    track.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(sync);
      },
      { passive: true },
    );

    prev.addEventListener("click", () => {
      goTo(current - 1);
      resume();
    });
    next.addEventListener("click", () => {
      goTo(current + 1);
      resume();
    });
    dots.forEach((d, i) =>
      d.addEventListener("click", () => {
        goTo(i);
        resume();
      }),
    );

    // Keyboard navigation on track
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") {
        e.preventDefault();
        goTo(current + 1);
        resume();
      }
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        goTo(current - 1);
        resume();
      }
    });

    // Gentle Autoplay (pauses on hover or focus)
    let timer = 0;
    const AUTOPLAY = 6000;
    const stop = () => {
      clearInterval(timer);
      timer = 0;
    };
    const start = () => {
      if (reduce || timer) return;
      timer = window.setInterval(() => {
        if (document.hidden) return;
        goTo(current + 1);
      }, AUTOPLAY);
    };
    let idleTimer = 0;
    const resume = () => {
      stop();
      clearTimeout(idleTimer);
      idleTimer = window.setTimeout(start, 4000);
    };

    ["pointerenter", "focusin"].forEach((ev) =>
      root.addEventListener(ev, stop),
    );
    ["pointerleave", "focusout"].forEach((ev) =>
      root.addEventListener(ev, resume),
    );

    // IntersectionObserver to run autoplay only when visible
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => (e.isIntersecting ? start() : stop()));
        },
        { threshold: 0.3 },
      ).observe(root);
    } else {
      start();
    }

    sync();
  })();
</script>
