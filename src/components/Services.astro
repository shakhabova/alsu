---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  {
    name: t('services.serv1.name'),
    desc: t('services.serv1.desc'),
    price: t('services.serv1.price'),
    unit: t('services.serv1.unit'),
    featured: false,
  },
  {
    name: t('services.serv2.name'),
    desc: t('services.serv2.desc'),
    price: t('services.serv2.price'),
    unit: t('services.serv2.unit'),
    featured: false,
  },
  {
    name: t('services.serv3.name'),
    desc: t('services.serv3.desc'),
    price: t('services.serv3.price'),
    unit: t('services.serv3.unit'),
    featured: true,
  },
  {
    name: t('services.serv4.name'),
    desc: t('services.serv4.desc'),
    price: t('services.serv4.price'),
    unit: t('services.serv4.unit'),
    featured: false,
  },
  {
    name: t('services.serv5.name'),
    desc: t('services.serv5.desc'),
    price: t('services.serv5.price'),
    unit: t('services.serv5.unit'),
    featured: false,
  },
  {
    name: t('services.serv6.name'),
    desc: t('services.serv6.desc'),
    price: t('services.serv6.price'),
    unit: t('services.serv6.unit'),
    featured: false,
  },
];
---

<section class="section services" id="services">
  <div class="container">
    <div class="services-head reveal">
      <span class="eyebrow">{t('services.eyebrow')}</span>
      <h2 class="section-title">{t('services.title')}</h2>
      <p class="lead">
        {t('services.lead')}
      </p>
    </div>

    <!-- Stages of Support Grid -->
    <div class="stages-grid reveal">
      <div class="stage-card">
        <span class="stage-num">01</span>
        <h3 class="stage-title">{t('services.stage1.title')}</h3>
        <div class="stage-desc-wrapper">
          <p class="stage-desc" set:html={t('services.stage1.desc')}></p>
          <button class="stage-more-btn" type="button" data-more={lang === 'ru' ? 'Подробнее' : 'Read more'} data-less={lang === 'ru' ? 'Скрыть' : 'Hide'}>
            {lang === 'ru' ? 'Подробнее' : 'Read more'}
          </button>
        </div>
      </div>

      <div class="stage-card">
        <span class="stage-num">02</span>
        <h3 class="stage-title">{t('services.stage2.title')}</h3>
        <div class="stage-desc-wrapper">
          <p class="stage-desc" set:html={t('services.stage2.desc')}></p>
          <button class="stage-more-btn" type="button" data-more={lang === 'ru' ? 'Подробнее' : 'Read more'} data-less={lang === 'ru' ? 'Скрыть' : 'Hide'}>
            {lang === 'ru' ? 'Подробнее' : 'Read more'}
          </button>
        </div>
      </div>

      <div class="stage-card">
        <span class="stage-num">03</span>
        <h3 class="stage-title">{t('services.stage3.title')}</h3>
        <div class="stage-desc-wrapper">
          <p class="stage-desc" set:html={t('services.stage3.desc')}></p>
          <button class="stage-more-btn" type="button" data-more={lang === 'ru' ? 'Подробнее' : 'Read more'} data-less={lang === 'ru' ? 'Скрыть' : 'Hide'}>
            {lang === 'ru' ? 'Подробнее' : 'Read more'}
          </button>
        </div>
      </div>
    </div>

    <!-- Decorative Separator -->
    <div class="stages-separator reveal">
      <div class="sep-line"></div>
      <span class="sep-text">{lang === 'ru' ? 'Тарифы и пакеты услуг' : 'Service Packages & Pricing'}</span>
      <div class="sep-line"></div>
    </div>

    <div class="services-grid">
      {services.map((s) => (
        <article class={`card reveal ${s.featured ? 'card--featured' : ''}`}>
          {s.featured && <span class="card-badge">{t('services.popular')}</span>}
          <h3 class="card-title">{s.name}</h3>
          <p class="card-desc">{s.desc}</p>
          <div class="card-foot">
            <div class="card-price">
              <span class="price">{s.price}</span>
              <span class="unit">{s.unit}</span>
            </div>
            <a href="#contact" class={`btn ${s.featured ? '' : 'btn--ghost'} card-btn`}>{t('services.choose')}</a>
          </div>
        </article>
      ))}
    </div>

    <p class="services-note reveal">
      {t('services.note')}
    </p>
  </div>
</section>

<style>
  .services { background: var(--cream-soft); }
  .services-head { max-width: 640px; margin-bottom: clamp(2.4rem, 5vw, 3.6rem); }
  .services-head .lead { margin-top: 1.2rem; }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.4rem;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2rem 1.9rem;
    background: var(--cream);
    border: 1px solid color-mix(in srgb, var(--taupe) 55%, transparent);
    border-radius: 18px;
    transition: transform .35s ease, box-shadow .35s ease, border-color .35s ease;
  }
  .card:hover {
    transform: translateY(-6px);
    box-shadow: 0 26px 50px -32px rgba(58,42,30,.55);
    border-color: var(--clay);
  }
  .card--featured {
    background: linear-gradient(180deg, #453422 0%, #372716 100%);
    border-color: transparent;
    color: var(--cream);
  }
  .card--featured .card-title,
  .card--featured .price { color: var(--cream); }
  .card--featured .card-desc { color: color-mix(in srgb, var(--cream) 82%, transparent); }
  .card--featured .unit { color: var(--clay); }

  .card-badge {
    align-self: flex-start;
    margin-bottom: 0.8rem;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.4em 1em;
    border-radius: 999px;
    background: var(--clay);
    color: var(--brown-deep);
    font-weight: 600;
  }

  .card-title {
    font-size: 1.55rem;
    margin-bottom: 0.7rem;
  }
  .card-desc {
    color: var(--brown-soft);
    font-size: 0.96rem;
    margin: 0 0 1.6rem;
    flex: 1;
  }

  .card-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .card-price { display: flex; flex-direction: column; }
  .price {
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1;
    color: var(--brown);
  }
  .unit {
    font-size: 0.76rem;
    letter-spacing: 0.03em;
    color: var(--brown-soft);
    margin-top: 0.3rem;
  }
  .card-btn { padding: 0.7em 1.5em; font-size: 0.78rem; }

  .services-note {
    text-align: center;
    margin-top: 2.4rem;
    color: var(--brown-soft);
    font-style: italic;
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  /* Stages of Support styling */
  .stages-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.4rem, 4vw, 2.5rem);
    margin-bottom: clamp(3rem, 7vh, 5rem);
    align-items: start;
  }
  .stage-card {
    background: var(--cream);
    border: 1px solid color-mix(in srgb, var(--taupe) 40%, transparent);
    padding: clamp(1.6rem, 3vw, 2.5rem);
    border-radius: 20px;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(58, 42, 30, 0.03);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .stage-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -20px rgba(58, 42, 30, 0.12);
  }
  .stage-num {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.8rem);
    color: color-mix(in srgb, var(--clay) 70%, transparent);
    line-height: 1;
    margin-bottom: 0.8rem;
    font-weight: 500;
  }
  .stage-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    color: var(--brown);
    margin-bottom: 1.2rem;
    line-height: 1.3;
    font-weight: 500;
  }
  .stage-desc {
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--brown-soft);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: max-height 0.35s ease;
  }
  .stage-card.is-expanded .stage-desc {
    display: block;
    overflow: visible;
    -webkit-line-clamp: unset;
  }
  .stage-desc :global(strong) {
    color: var(--brown);
    font-weight: 500;
  }

  .stage-more-btn {
    background: none;
    border: none;
    padding: 0;
    margin-top: 0.8rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--clay);
    cursor: pointer;
    transition: color 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .stage-more-btn:hover {
    color: var(--brown);
  }
  .stage-more-btn::after {
    content: "→";
    display: inline-block;
    transition: transform 0.3s ease;
  }
  .stage-card.is-expanded .stage-more-btn::after {
    transform: rotate(90deg);
  }

  /* Decorative Separator */
  .stages-separator {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }
  .sep-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--taupe) 50%, transparent);
  }
  .sep-text {
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--clay);
    font-weight: 500;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .stages-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (() => {
    const cards = Array.from(document.querySelectorAll('.stage-card'));
    cards.forEach((card) => {
      const btn = card.querySelector('.stage-more-btn');
      if (!btn) return;
      btn.addEventListener('click', () => {
        const isExpanded = card.classList.toggle('is-expanded');
        btn.textContent = isExpanded ? btn.dataset.less : btn.dataset.more;
      });
    });
  })();
</script>
