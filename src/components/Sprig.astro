---
/**
 * Sprig — the DOULA ALSU HAKIM plant mark, recreated as line art.
 * Uses currentColor so it inherits the surrounding text colour.
 */
interface Props {
  size?: number | string;
  class?: string;
  strokeWidth?: number;
}
const { size = 64, class: cls = "", strokeWidth = 3 } = Astro.props;
